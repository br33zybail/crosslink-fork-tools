# config.example.env: copy to config.env (gitignored), edit, then load it
# before each script, for example from cron:
#   set -a; . /path/to/config.env; set +a; /path/to/bin/tip-track.sh
# Every value below is a placeholder. Scripts fall back to the same
# placeholders, which fail closed (BLIND, rpc-down, or exit 2), never "OK".

# ── shared ───────────────────────────────────────────────────────────────────
# Node JSON-RPC endpoint (no auth support; keep it on loopback).
RPC_URL=http://127.0.0.1:PORT
# Where the scripts keep counters, flags, checkpoints and incident files.
# Keep it private to the node's user (mkdir -m 700): the scripts write fixed
# file names here, and anyone who can write to it can plant symlinks.
STATE_DIR=/path/to/crosslink-fork-tools/state
# systemd unit that runs the node, and whether it is a system or user unit.
NODE_UNIT=crosslink-node.service
SYSTEMD_SCOPE=--system
# Alerts. Set ONE of these, or neither to only log.
# ALERT_CMD is run as: $ALERT_CMD "<title>" "<priority>" "<message>"
# (priority is default, high or urgent; the value is split on whitespace, with
# no globbing and no eval, so quotes inside it are NOT honoured).
ALERT_CMD=
# ALERT_WEBHOOK gets an HTTP POST: message as body, "Title:" and "Priority:" headers.
ALERT_WEBHOOK=

# ── tip-track.sh ─────────────────────────────────────────────────────────────
# Reference A: block API with /tip and /block/<height> (see README for the JSON shape).
REF_A_API=https://reference-a.invalid/api
# Reference B: fork-monitor JSON with a tip, tip hash and deep anchors.
REF_B_URL=https://reference-b.invalid/fork-monitor
USER_AGENT=crosslink-fork-tools
# Tip-minus offsets that reference A is checked at.
REF_A_DEPTHS="5 20 100 500 2000"
# A checkpoint is only certified this many blocks below our tip.
SAFE_DEPTH=500
# Consecutive runs with zero hash comparisons before the BLIND page.
MAX_BLACKOUT=4
# Runs between repeat BLIND pages while still blind.
BLIND_REPAGE=120
# A reference more than this many blocks behind us can't vouch for our tip.
LAG_WARN=150
# Reference B tip-probe mismatches before a "tip churn" warning, and the streak
# that counts as divergence even with all anchors green.
REF_B_TIP_STRIKES=2
REF_B_TIP_ESCALATE=6
# Fewer connected peers than this = peer-isolated warning.
MIN_PEERS=2
# Seconds to wait before retrying a failed getpeerinfo.
PEER_RETRY_SLEEP=5

# ── node-watch.sh ────────────────────────────────────────────────────────────
BEHIND_LIMIT=20
JOURNAL_LINES=300
GENESIS_STORM=50
# Consecutive runs with no peer line in the journal before paging no-peer-line.
NOLINE_RUNS=3
# Defaults to $STATE_DIR/node-watch.log
NODE_WATCH_LOG=

# ── identity-guard.sh ────────────────────────────────────────────────────────
# The node's state cache directory. A second zebrad holding it open is a second
# instance of this node, signing with the same finalizer identity.
FINALIZER_CACHE_DIR=/path/to/zebra/state-cache
# Binaries that can sign, and the pgrep -f pattern for the census.
SIGNER_EXE_GLOB='zebrad*'
SIGNER_PGREP=zebrad
# Colon-separated working directories of other instances that run with their
# OWN identity (test rigs). Anything else zebrad-like outside the unit pages.
ALLOW_CWDS=

# ── fork-report.sh / version-uptime.sh ───────────────────────────────────────
# One line naming the release tag you run. Change it and the counters restart.
VERSION_FILE=/path/to/installed-version
# Node config, read only to report whether internal_miner = true.
ZEBRAD_TOML=/path/to/zebrad.toml
# Seconds per version-uptime.sh run; must match its cron interval.
TICK=300
